{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skooli Buddy school-context pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "parent_authored",
    "topics",
    "dropped",
    "nudge_homework",
    "write_back_to_school"
  ],
  "properties": {
    "parent_authored": { "type": "boolean" },
    "valid_from": { "type": ["string", "null"] },
    "valid_until": { "type": ["string", "null"] },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "theme"],
        "properties": {
          "subject": { "type": "string" },
          "theme": { "type": "string" },
          "title": { "type": "string" }
        }
      }
    },
    "dropped": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nudge_homework": { "type": "boolean", "const": false },
    "write_back_to_school": { "type": "boolean", "const": false }
  }
}
